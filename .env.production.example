# =============================================================================
# Craft Suite Website — Production Environment Variables
# Copy to .env.production or configure in Vercel / Cloudflare Pages / Docker
# =============================================================================

# Primary Brand Identity (White-Label Configuration)
NEXT_PUBLIC_BRAND_NAME="Craft Suite"
NEXT_PUBLIC_BRAND_SHORT_NAME="Craft"
NEXT_PUBLIC_GITHUB_ORG="fajrulmuyaqqin-wq"

# Public Domain & Backend Services Endpoints
NEXT_PUBLIC_SITE_URL="https://craft.yourdomain.com"
NEXT_PUBLIC_WEBAPP_URL="https://app.craft.yourdomain.com"
NEXT_PUBLIC_API_HOST="https://api.craft.yourdomain.com"

# Static Media CDN (leave empty to serve white-labeled assets from /public)
NEXT_PUBLIC_MEDIA_CDN=""

# Social & Community Links
NEXT_PUBLIC_GITHUB_URL="https://github.com/fajrulmuyaqqin-wq"
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_X_URL=""
NEXT_PUBLIC_BLUESKY_URL=""
NEXT_PUBLIC_REDDIT_URL=""

# Desktop App Installer Overrides (optional — defaults to GitHub Releases under NEXT_PUBLIC_GITHUB_ORG)
NEXT_PUBLIC_DOWNLOADS_ENABLED="true"
# NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL="https://github.com/fajrulmuyaqqin-wq/craft/releases/download/v0.1.5/Craft-Setup-0.1.5.exe"
# NEXT_PUBLIC_MACOS_DOWNLOAD_URL="https://github.com/fajrulmuyaqqin-wq/craft/releases/download/v0.1.5/Craft-0.1.5-universal.dmg"
